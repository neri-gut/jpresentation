# Seguridad npm — JPresentation
# Requiere npm >= 11.10 (min-release-age, allow-git).
# npm run / npm start SÍ ejecutan tus scripts; esto solo bloquea
# preinstall/install/postinstall de las dependencias.

ignore-scripts=true
allow-git=none
min-release-age=7
save-exact=true
package-lock=true
engine-strict=true
audit=true
audit-level=high
fund=false
update-notifier=false
before=null
lockfile-version=3
